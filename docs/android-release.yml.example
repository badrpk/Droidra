name: Android Release AABs
on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - 'apps/**'
      - 'shared/**'
      - '**.gradle.kts'

jobs:
  build:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        app: [sophyane, khaana, mypharma, bijli, laibabadar, rangoons, vps, shmry, huobz, nifdu, darulsakina, cast, xerus]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - name: Setup Android SDK
        uses: android-actions/setup-android@v3
      - name: local.properties from secrets
        run: |
          echo "sdk.dir=$ANDROID_SDK_ROOT" > local.properties
          echo "GCP_API_KEY=${{ secrets.GCP_API_KEY }}" >> local.properties
          echo "GOOGLE_API_KEY=${{ secrets.GCP_API_KEY }}" >> local.properties
          echo "MAPS_API_KEY=${{ secrets.GCP_API_KEY }}" >> local.properties
      - name: Decode keystore (optional)
        if: ${{ secrets.KEYSTORE_BASE64 != '' }}
        run: |
          mkdir -p secrets
          echo "${{ secrets.KEYSTORE_BASE64 }}" | base64 -d > secrets/release.keystore
      - name: Grant gradlew
        run: chmod +x gradlew || true
      - name: Build bundle
        env:
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: |
          if [ -f gradlew ]; then ./gradlew :apps:${{ matrix.app }}:bundleRelease --stacktrace
          else
            # bootstrap wrapper if missing
            gradle wrapper --gradle-version 8.2 || true
            ./gradlew :apps:${{ matrix.app }}:bundleRelease --stacktrace
          fi
      - uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.app }}-aab
          path: apps/${{ matrix.app }}/build/outputs/bundle/release/*.aab
